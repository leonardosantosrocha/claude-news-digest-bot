# ---------- Secoes ----------
# Os temas do digest ficam em config/sections.json (uma secao por tema, com sua cota).
SECTIONS_PATH=config/sections.json
# Preenchido = ignora as secoes e faz uma busca pontual desse unico tema.
TOPIC_OVERRIDE=
# Quantidade de noticias na busca pontual (TOPIC_OVERRIDE / --topic)
NEWS_LIMIT=3

# ---------- Busca ----------
# O digest usa apenas o feed internacional em ingles (en-US).
# Janela de busca, em horas
NEWS_LOOKBACK_HOURS=24
# Provedor de noticias (hoje apenas "rss")
NEWS_PROVIDER=rss
# Limite de artigos enviados ao DeepSeek POR SECAO
MAX_ARTICLES_FOR_ANALYSIS=20

# ---------- Historico ----------
# Janela para considerar uma noticia como ja enviada
DUPLICATE_LOOKBACK_DAYS=7
HISTORY_PATH=data/sent_news.json

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- E-mail (Resend) ----------
RESEND_API_KEY=
# Remetente: precisa de dominio verificado no Resend.
# Para testes, use onboarding@resend.dev (so envia para o e-mail dono da conta).
EMAIL_FROM=onboarding@resend.dev
EMAIL_TO=

# ---------- Geral ----------
TIMEZONE=America/Sao_Paulo
# Executa sem enviar e-mail nem gravar historico
DRY_RUN=false
